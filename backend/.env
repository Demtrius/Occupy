# Django Core Settings
SECRET_KEY=django-insecure-dev-secret-key-change-this-in-production-12345abcdef
DEBUG=True
DJANGO_ENVIRONMENT=development

# PostgreSQL Database Configuration (Docker Compose)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=occupy7
DB_USER=sam
DB_PASSWORD=chiraqmony
DB_HOST=localhost
DB_PORT=5432

# Alternative database config when running Django inside Docker
# (Change DB_HOST to 'db' if running Django in Docker container)
# DB_HOST=db

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# JWT Authentication Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Configuration (Console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Redis Configuration (Optional - can use localhost or docker service name)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/1

# Docker Compose Environment Variables (used by docker-compose.yml)
DATABASE_NAME=occupy7
DATABASE_USER=sam
DATABASE_PASSWORD=chiraqmony
DJANGO_DEBUG=True

# Logging Level
LOG_LEVEL=DEBUG

# Static and Media Files
STATIC_URL=/static/
MEDIA_URL=/media/
