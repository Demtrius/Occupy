[flake8]
max-line-length = 88
exclude = 
    .git,
    __pycache__,
    */migrations/*,
    .venv,
    env,
    venv,
    .tox,
    build,
    dist,
    *.egg-info

ignore = 
    E203,  # whitespace before ':'
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator

per-file-ignores =
    */settings/*.py:F403,F401
    */tests/*.py:F401

max-complexity = 10
