venv/
# Keep poetry.lock committed, do NOT ignore it

# ----------------------------
# Alembic / DB
# ----------------------------
# Keep migrations tracked!
# alembic/versions/*.py  <-- DO NOT IGNORE (commit your migrations)

# ----------------------------
# Environment / secrets
# ----------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.production.example
*.pem
*.key
*.crt
*.cer
*.p12
*.mobileprovision

# ----------------------------
# Logs / runtime
# ----------------------------
logs/
*.log
*.pid
*.seed
*.pid.lock

# ----------------------------
# Docker
# ----------------------------
# No local bind-mount data dirs expected here; volumes live outside repo
# Ignore any accidental data dirs
data/
tmp/
run/

# ----------------------------
# Misc
