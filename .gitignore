ios/Pods/
ios/build/
ios/DerivedData/
*.xcuserdatad/
*.xcworkspace
*.xcuserstate

# ----------------------------
# TypeScript outputs (if any local builds)
# ----------------------------
*.tsbuildinfo
build/
out/
dist/

# ----------------------------
# Python / Poetry
# ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
