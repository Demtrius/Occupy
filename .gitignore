# Root level gitignore for Occupy project
# Covers both mobile (Expo/React Native) and backend (Django) components

# Dependencies
node_modules/
.venv/
.env/
venv/
ENV/
env/

# Python
*.pyc
*.pyo
*.pyd
__pycache__/
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
/static/
.coverage
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Expo & React Native
.expo/
dist/
web-build/
expo-env.d.ts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*

# Build outputs
build/
ios/
android/
*.ipa
*.apk
*.aab

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*
.nyc_output

# Environment variables
.env
.env*.local
.environment

# IDE & Editor
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# TypeScript
*.tsbuildinfo

# Temporary folders
tmp/
temp/

# Docker
docker-compose.override.yml

# Backup files
*.bak
*.backup

# Certificate files
*.pem
*.crt
*.cer
*.der

# Test files
test-results/
playwright-report/
test-results.xml

# Database
*.sqlite
*.db

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
