{
	"cli": {
		"version": ">= 3.0.0"
	},
	"build": {
		"develop": {
			"developmentClient": false,
			"distribution": "internal",
			"ios": {
				"simulator": false,
				"buildConfiguration": "Release"
			}
		},
		"preview": {
			"distribution": "internal"
		},
		"production": {
			"distribution": "store",
			"ios": {
				"simulator": false,
				"buildConfiguration": "Release"
			},
			"cache": {
				"key": "v1.0.1"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"appleId": "samihuomaoccupy@gmail.com",
				"env": {
					"EXPO_PUBLIC_BACKEND_URL": "https://www.occupy-app.com",
					"EXPO_PUBLIC_ENV": "development",
					"EXPO_PUBLIC_DEBUG": true,
					"EXPO_PUBLIC_API_TIMEOUT": 15000
				}
			}
		}
	}
}
