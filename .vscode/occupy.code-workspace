{
	"folders": [
		{
			"name": "Mobile (Expo/React Native)",
			"path": "./mobile"
		},
		{
			"name": "Backend (Django)",
			"path": "./backend"
		},
		{
			"name": "Root",
			"path": "./"
		}
	],
	"settings": {
		"files.exclude": {
			"**/node_modules": true,
			"**/.expo": true,
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/dist": true,
			"**/web-build": true,
			".venv": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/.expo": true,
			"**/__pycache__": true,
			"**/dist": true,
			"**/web-build": true,
			".venv": true
		},
		"python.defaultInterpreterPath": "./.venv/bin/python",
		"python.terminal.activateEnvironment": true,
		"python.linting.enabled": true,
		"python.linting.pylintEnabled": true,
		"python.formatting.provider": "black",
		"python.sortImports.args": ["--profile", "black"],
		"typescript.preferences.importModuleSpecifier": "relative",
		"javascript.preferences.importModuleSpecifier": "relative",
		"emmet.includeLanguages": {
			"javascript": "javascriptreact"
		},
		"editor.codeActionsOnSave": {
			"source.organizeImports": "explicit",
			"source.fixAll.eslint": "explicit"
		},
		"editor.formatOnSave": true,
		"editor.rulers": [80, 120],
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"terminal.integrated.cwd": "${workspaceFolder}",
		"git.ignoreLimitWarning": true
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.black-formatter",
			"ms-python.isort",
			"ms-python.pylint",
			"bradlc.vscode-tailwindcss",
			"esbenp.prettier-vscode",
			"dbaeumer.vscode-eslint",
			"ms-vscode.vscode-typescript-next",
			"expo.vscode-expo-tools",
			"ms-vscode.vscode-json",
			"redhat.vscode-yaml",
			"ms-vscode.vscode-eslint",
			"formulahendry.auto-rename-tag",
			"christian-kohler.path-intellisense",
			"ms-vscode.sublime-keybindings",
			"gitpod.gitpod-desktop"
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "🚀 Start Mobile Development",
				"type": "shell",
				"command": "make",
				"args": ["dev-mobile"],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "🔧 Start Backend Development",
				"type": "shell",
				"command": "make",
				"args": ["dev-backend"],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "🚀 Start Full Development Environment",
				"type": "shell",
				"command": "make",
				"args": ["dev"],
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "🧹 Clean Project",
				"type": "shell",
				"command": "make",
				"args": ["clean"],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "📋 Check Mobile (Expo Doctor)",
				"type": "shell",
				"command": "make",
				"args": ["check-mobile"],
				"group": "test",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "📋 Check Backend (Django Check)",
				"type": "shell",
				"command": "make",
				"args": ["check-backend"],
				"group": "test",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "📦 Setup Project",
				"type": "shell",
				"command": "make",
				"args": ["setup"],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "🔄 Django Migrations",
				"type": "shell",
				"command": "make",
				"args": ["migrate"],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "📱 Build Mobile App (All Platforms)",
				"type": "shell",
				"command": "make",
				"args": ["build-mobile"],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			},
			{
				"label": "📋 Show Available Commands",
				"type": "shell",
				"command": "make",
				"args": ["help"],
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "new"
				},
				"problemMatcher": []
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Django Server",
				"type": "python",
				"request": "launch",
				"program": "${workspaceFolder}/backend/manage.py",
				"args": ["runserver", "127.0.0.1:8000"],
				"django": true,
				"cwd": "${workspaceFolder}/backend",
				"env": {
					"PYTHONPATH": "${workspaceFolder}/backend"
				},
				"console": "integratedTerminal"
			},
			{
				"name": "Django Shell",
				"type": "python",
				"request": "launch",
				"program": "${workspaceFolder}/backend/manage.py",
				"args": ["shell"],
				"django": true,
				"cwd": "${workspaceFolder}/backend",
				"console": "integratedTerminal"
			},
			{
				"name": "Attach to Expo",
				"type": "node",
				"request": "attach",
				"port": 19000,
				"address": "localhost",
				"localRoot": "${workspaceFolder}/mobile",
				"remoteRoot": "${workspaceFolder}/mobile",
				"protocol": "inspector"
			}
		],
		"compounds": [
			{
				"name": "Full Stack Debug",
				"configurations": ["Django Server", "Attach to Expo"]
			}
		]
	}
}
